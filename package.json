{
  "name": "stylelint-magic-numbers",
  "version": "2.1.0",
  "description": "Plugin for stylelint with magic number rules.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Julian Strecker <julianstrecker@gmail.com>",
  "bugs": {
    "url": "https://github.com/JuStTheDev/stylelint-magic-numbers/issues"
  },
  "homepage": "https://github.com/JuStTheDev/stylelint-magic-numbers#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuStTheDev/stylelint-magic-numbers.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint '**/*.{js,cjs,mjs,ts,cts,mts}'",
    "lint:fix": "eslint '**/*.{js,cjs,mjs,ts,cts,mts}' --fix",
    "release:official": "release-it --config .release-it--official.json",
    "release:dry": "release-it --dry-run",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "postcss-selector-parser": "^7.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.4",
    "csstype": "^3.2.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "release-it": "^21.1.0",
    "stylelint": "^16.26.1",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7",
    "vitest-stylelint-utils": "^2.0.0"
  },
  "peerDependencies": {
    "stylelint": "^16.0.0 || ^17.0.0"
  },
  "keywords": [
    "css",
    "css lint",
    "stylelint",
    "stylelint plugin",
    "stylelint-plugin",
    "magic-numbers",
    "magic-colors"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
